{
  "name": "forgenotes-recorder",
  "version": "1.0.1",
  "private": true,
  "description": "ForgeNotes desktop recorder for online calls and single-microphone room recordings.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "verify": "node --check renderer/app.js && node --check main.js && node scripts/verify-capture-profile.mjs",
    "prepare:config": "node scripts/write-production-config.mjs",
    "dist:win": "npm run prepare:config && electron-builder --win --x64 --publish never",
    "release": "electron-builder --win --publish always",
    "dist:store": "npm run prepare:config && electron-builder --win appx --x64 --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-store-package.ps1",
    "test": "node --test scripts/test-recording-store.cjs",
    "test:media-runtime": "electron scripts/test-media-runtime.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.thecontentforge.forgenotes.recorder",
    "productName": "ForgeNotes Recorder",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "icon.png",
      "config.json",
      "config.example.json",
      "recording-store.js"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "ForgeNotes-Recorder-Setup.${ext}",
    "publish": {
      "provider": "github",
      "owner": "fecktk1",
      "repo": "forgenotes-recorder",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "identityName": "TheContentForge.ForgeNotes",
      "publisher": "CN=A84C1C04-6C8F-437D-9CBF-B6FF012AA829",
      "publisherDisplayName": "TheContentForge",
      "displayName": "ForgeNotes",
      "applicationId": "ForgeNotesRecorder",
      "backgroundColor": "#141414",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "microphone"
      ]
    }
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "@xmldom/xmldom": "0.8.15"
  }
}
